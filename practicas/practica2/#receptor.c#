#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <ctype.h>
#include <sys/socket.h>
#include <sys/ioctl.h>
#include <net/if.h>
#include <linux/if_packet.h>
#include <linux/if_ether.h>
#include <arpa/inet.h>

#define ETHERTYPE_PRACTICA 0x88B5

static void imprime_mac(const char *etiqueta, const unsigned char *m)
{
    printf("  %-11s: %02x:%02x:%02x:%02x:%02x:%02x\n",
           etiqueta, m[0], m[1], m[2], m[3], m[4], m[5]);
}

int main(int argc, char *argv[])
{
    if (argc != 2) {
        fprintf(stderr, "Uso: %s <interfaz>\n", argv[0]);
        return 1;
    }

    int sock = socket(AF_PACKET, SOCK_RAW, htons(ETH_P_ALL));
    if (sock < 0) {
        perror("socket (¿ejecutaste con sudo?)");
        return 1;
    }

    /* Enlazar el socket a la interfaz indicada */
    struct ifreq ifr;
    memset(&ifr, 0, sizeof(ifr));
    strncpy(ifr.ifr_name, argv[1], IFNAMSIZ - 1);
    if (ioctl(sock, SIOCGIFINDEX, &ifr) < 0) { perror("SIOCGIFINDEX"); return 1; }

    struct sockaddr_ll sll;
    memset(&sll, 0, sizeof(sll));
    sll.sll_family   = AF_PACKET;
    sll.sll_ifindex  = ifr.ifr_ifindex;
    sll.sll_protocol = htons(ETH_P_ALL);
    if (bind(sock, (struct sockaddr *)&sll, sizeof(sll)) < 0) {
        perror("bind");
        return 1;
    }

    printf("Escuchando tramas 0x%04X en %s (Ctrl+C para salir)...\n\n",
           ETHERTYPE_PRACTICA, argv[1]);

    unsigned char buffer[ETH_FRAME_LEN + 4];
    int contador = 0;

    while (1) {
        ssize_t n = recvfrom(sock, buffer, sizeof(buffer), 0, NULL, NULL);
        if (n < 0) { perror("recvfrom"); break; }
        if (n < ETH_HLEN) continue;

        struct ethhdr *eth = (struct ethhdr *)buffer;
        if (ntohs(eth->h_proto) != ETHERTYPE_PRACTICA) continue;

        unsigned char *payload = buffer + ETH_HLEN;
        size_t payload_len = n - ETH_HLEN;

        printf("=== Trama #%d recibida (%zd bytes) ===\n", ++contador, n);
        imprime_mac("MAC destino", eth->h_dest);
        imprime_mac("MAC origen", eth->h_source);
        printf("  EtherType  : 0x%04X\n", ntohs(eth->h_proto));
        printf("  Payload    : %zu bytes\n", payload_len);

        /* Texto (hasta el primer '\0', el resto es relleno) */
        printf("  Texto      : ");
        for (size_t i = 0; i < payload_len && payload[i] != '\0'; i++)
            putchar(isprint(payload[i]) ? payload[i] : '.');
        putchar('\n');

        /* Volcado hexadecimal */
        printf("  Hex        :");
        for (size_t i = 0; i < payload_len; i++) {
            if (i % 16 == 0) printf("\n    ");
            printf("%02x ", payload[i]);
        }
        printf("\n\n");
    }

    close(sock);
    return 0;
}
