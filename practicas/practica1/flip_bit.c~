#include <stdio.h>
#include <stdlib.h>
#include <time.h>

//Función que simula la transmición de un bit utiliando NRZ
void transmitir_bit_nrz(int bit) {
 
    if (bit == 1) {
        printf("[+5V]");
    } else {
        printf("[-5V]");
    }
    
}

//Función para imprimir únicamente la cadena de bits resultantes
void imprimir_solo_bits(const char *palabra) {
    for (int i = 0; palabra[i] != '\0'; i++) {
        for (int bit = 7; bit >= 0; bit--) {
            int bitActual = (palabra[i] >> bit) & 1;
            printf("%d", bitActual);
        }
        printf(" ");
    }
    printf("\n");
}

/*Función que procesa cada carácter de la palabra
 * muestra el cracter, sus 8 bits y la señal electrica 
 * que le corresponde a cada bit
 */
void procesar_palabra(const char *palabra) {
    for (int i = 0; palabra[i] != '\0'; i++) {
        char caracter = palabra[i];

        printf("Caracter: '%c'\n", caracter);
        printf("Bits:     ");

        for (int bit = 7; bit >= 0; bit--) {
            int bitActual = (caracter >> bit) & 1;
            printf("%d", bitActual);
        }

        printf("\nSeñal:    ");

        for (int bit = 7; bit >= 0; bit--) {
            int bitActual = (caracter >> bit) & 1;
            transmitir_bit_nrz(bitActual);
            printf(" ");
        }

        printf("\n\n");
    }
}

/*Función que simula el ruido del canal
 *cada bit tiene una probabilidad determinada de ser alterado
 */
void alterar_bits(char *palabra, float probabilidad) {
    for (int i = 0; palabra[i] != '\0'; i++) {
        char caracterOriginal = palabra[i];

        for (int bit = 0; bit < 8; bit++) {
            float aleatorio = (float)rand() / RAND_MAX;

            if (aleatorio < probabilidad) {
                int bitOriginal = (palabra[i] >> bit) & 1;

                palabra[i] ^= (1 << bit);

                int bitNuevo = (palabra[i] >> bit) & 1;

                printf("Caracter '%c', bit %d: %d -> %d\n",
                       caracterOriginal,
                       bit,
                       bitOriginal,
                       bitNuevo);
            }
        }
    }
}


int main() {
    char palabra[100];
    float probabilidad;

    srand(time(NULL));

    printf("\n--- Simulador de capa 1 (Capa física) ---\n");
    printf("Introduce una palabra para transmitir: ");
    scanf("%99s", palabra);

    printf("Introduce la probabilidad de ruido del canal (0.0 a 1.0): ");
    scanf("%f", &probabilidad);

    // Validar la probabilidad
    if (probabilidad < 0.0 || probabilidad > 1.0) {
        printf("Error: la probabilidad debe estar entre 0.0 y 1.0\n");
        return 1;
    }

    printf("\n--- Procesamiento de bits y voltajes ---\n");
    procesar_palabra(palabra);

    printf("\n--- Ruido del canal ---\n");
    alterar_bits(palabra, probabilidad);

    printf("\nNueva serie de bits:\n");
    imprimir_solo_bits(palabra);

    printf("\n--- 2. Simulación de transmisión con ruido ---\n");
    printf("Palabra: %s\n", palabra);
    printf("Transmisión finalizada.");

    return 0;
}
